<?xml version="1.0" encoding="utf-8"?>
<!-- "İstatistiklerim" — beş kaldırılan basit widget'ın (Hedef Takibi/Rüya
     Günlüğü/Şükran Günlüğü/Ruh Hali Takibi/Manifest Günlüğü) YERİNE geçen,
     Profil ekranındaki dört kategoriyi (Para Yönetimi/Şükür ve Manifest/
     İstikrar/Öz Saygı ve Sağlık) bir `ViewFlipper` ile sırayla, animasyonla
     döndüren carousel widget'ı — bkz. CLAUDE.md "Ana Ekran Widget'ları"
     bölümü. "Zibo'nun Sözü" widget'ıyla AYNI kompozisyon (karakter görseli
     solda, içerik sağda, köşede logo) — kullanıcının "zibo logosu ve zibo
     görselini kullanmayı unutma" isteği. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_character"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            android:src="@drawable/widget_zibo_character"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/widget_secondary_text"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="İstatistiklerim" />

            <TextView
                android:id="@+id/widget_accent_bar"
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp" />

            <ViewFlipper
                android:id="@+id/widget_stats_flipper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:flipInterval="4500"
                android:autoStart="true"
                android:inAnimation="@anim/widget_page_in"
                android:outAnimation="@anim/widget_page_out">
                <!-- Boş durum yer tutucusu — Kotlin gerçek veri geldiğinde
                     `removeAllViews` + dört gerçek `widget_stat_page_*`
                     sayfasını EKLER (bkz. widget_quote_flipper'daki AYNI
                     not). `<include>` KULLANILMADI — RemoteViews'ın
                     inflate kısıtlamalarıyla test EDİLMEMİŞ bir mekanizmayı
                     riske atmamak için doğrudan aynı yapı inline yazıldı. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/widget_secondary_text"
                        tools:text="Para Yönetimi" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_primary_text"
                        tools:text="7,5 / 10" />
                </LinearLayout>
            </ViewFlipper>
        </LinearLayout>
    </LinearLayout>

    <!-- Zibo logosu — 2026 güncellemesi: alpha 0.18→0.5, boyut büyütüldü,
         bkz. widget_module.xml'deki AYNI notun tam açıklaması. -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="20dp"
        android:layout_gravity="bottom|end"
        android:src="@drawable/widget_zibo_logo"
        android:alpha="0.5"
        android:scaleType="fitEnd"
        android:importantForAccessibility="no" />
</FrameLayout>
