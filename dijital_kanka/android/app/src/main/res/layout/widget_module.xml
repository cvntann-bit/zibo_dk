<?xml version="1.0" encoding="utf-8"?>
<!-- Ana ekran widget'larının TEK, paylaşılan RemoteViews şablonu — SEKİZ
     modül widget'ının (bkz. ZiboBaseWidgetProvider.kt) HEPSİ bu AYNI
     layout'u kullanıyor, yalnızca içerik (ikon/renk/metin/ilerleme)
     Kotlin'den dolduruluyor. Uygulamanın gerçek honey/mustard temasıyla
     eşleşen renk paleti için bkz. values(/-night)/colors.xml.

     2026 güncellemesi — kullanıcı isteği "widget tasarımlarını daha güzel
     ve çeşitli yap, Zibo'nun logosunu kullanabilirsin": rozetin arkasına
     modülün kendi accent renginde soluk bir "halo" eklendi (sekiz modül
     artık yalnızca rozetin İÇİ değil, ETRAFI da kendi rengiyle ayırt
     ediliyor — "çeşitlilik" isteğinin karşılığı, mevcut `accentColor`
     altyapısı zaten her modülde farklı olduğu için YENİ bir renk sistemi
     icat etmeye gerek kalmadan), başlık ile ana metin arasındaki (eskiden
     çökmeye yol açan ham `<View>` spacer'ın yerini alan, bkz. altta) boşluk
     artık modülün rengiyle dolu ince bir "accent bar"a dönüştürüldü, ve
     kartın sağ-alt köşesine soluk bir Zibo logosu (`widget_zibo_logo.png`
     — mevcut `zibo_splash_logo.png`'nin native/RemoteViews-uyumlu bir
     kopyası, `tool/prepare_widget_assets.dart` ile üretildi) eklendi —
     kullanıcının "Zibo'nun logosunu kullanabilirsin" isteği. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Rozet + arkasındaki soluk "halo" — halo, badge'in AYNI
                 dairesel drawable'ını (bkz. widget_badge_circle.xml) daha
                 büyük boyutta VE modülün accent rengiyle DÜŞÜK opaklıkta
                 tonlayarak (bkz. ZiboBaseWidgetProvider.withAlpha) çiziyor;
                 üstüne AYNI eski 26dp'lik tam-opak rozet ortalanıyor. -->
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">

                <ImageView
                    android:id="@+id/widget_icon_halo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/widget_badge_circle"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/widget_icon_bg"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_badge_circle"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/widget_icon_emoji"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:importantForAccessibility="no"
                    tools:text="🎯" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:textSize="12sp"
                android:textColor="@color/widget_secondary_text"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Hedef Takibi" />
        </LinearLayout>

        <!-- 2026 bug düzeltmesi (bkz. CLAUDE.md "Ana Ekran Widget'ları"
             bölümü) — burada ham bir `<View>` spacer, RemoteViews'ın
             inflate ETMEYE İZİN VERDİĞİ sınıflar listesinde olmadığı için
             (`InflateException: Class not allowed to be inflated android.
             view.View`, gerçek cihazda canlı `adb logcat` ile doğrulandı)
             "Araç yüklenemiyor" çökmesine yol açıyordu. **Boşluk artık
             SIRADAN bir margin DEĞİL, modülün accent rengiyle dolu ince bir
             "accent bar" — hem eski çökme kesin olarak önleniyor (TextView
             RemoteViews'ın desteklediği bir sınıf) HEM DE görsel çeşitlilik
             isteğine bir vurgu daha ekleniyor.** -->
        <TextView
            android:id="@+id/widget_accent_bar"
            android:layout_width="30dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/widget_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/widget_primary_text"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="3/7 gün" />

        <TextView
            android:id="@+id/widget_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="@color/widget_secondary_text"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="bugün işaretlenen hedef" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="40"
            android:progressTint="@color/widget_accent_default"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Zibo logosu — kartın sağ-alt köşesinde, içeriğin ÜSTÜNDE (FrameLayout'ta
         son çocuk) bir marka imzası. **2026 güncellemesi — kullanıcı raporu "shake
         kasıyormuş gibi durdu, akıcı olsun":** eski 8-kareli (0/0/0/-8/8/-4/0/0°,
         600ms/kare, geçişler ANİ) tasarım kaba/sarsıntılı hissettiriyordu. Yerine
         28 KARELİK, İNCE AÇI ADIMLI bir "flip-book" dizisi kondu — klasik sprite/
         film şeridi animasyon tekniği: her komşu kare arasındaki açı farkı yalnızca
         birkaç derece (bir sinüs eğrisinin 12 örneklemi: 0°→4°→7°→8°→7°→4°→0°→-4°→
         -7°→-8°→-7°→-4°→0°, TAM BİR sallanma jesti) OLDUĞU İÇİN, kısa bir
         `flipInterval=70ms`'de (12 kare × 70ms ≈ 840ms'lik akıcı bir sallanma) göz
         bunu SÜREKLİ/AKIŞKAN bir hareket olarak algılıyor — kaba sıçramalar YOK.
         Ardından 16 KARE 0°'de (16×70ms ≈ 1.1sn) "hafif duraksamalı" isteğinin
         karşılığı olan bir DİNLENME dönemi var, sonra döngü tekrarlıyor. Geçiş
         animasyonu (`in/outAnimation`) YİNE BİLEREK YOK — ince açı adımları ZATEN
         akıcı, üstüne bir de solma/kayma binmesi (özellikle bu kadar küçük bir
         logoda) net rotasyon hissini bulanıklaştırırdı. -->
    <ViewFlipper
        android:id="@+id/widget_logo_flipper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:flipInterval="70"
        android:autoStart="true">
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="4" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="7" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="8" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="7" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="4" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="-4" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="-7" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="-8" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="-7" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="-4" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="42dp" android:layout_height="17dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
    </ViewFlipper>
</FrameLayout>
