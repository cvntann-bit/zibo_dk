<?xml version="1.0" encoding="utf-8"?>
<!-- "Zibo'nun Sözü" — büyük, ViewFlipper tabanlı carousel widget'ı (bkz.
     CLAUDE.md "Ana Ekran Widget'ları" bölümü). Gerçek bir Zibo karakter
     görseli (`widget_zibo_character.png`) + çok satırlı, OTOMATİK DÖNEN
     bir söz metni içeriyor.

     2026 güncellemesi — kullanıcı isteği "sözler 3 dakikada bir değişsin":
     tek statik `TextView` yerine artık bir `ViewFlipper`
     (`widget_quote_flipper`) var — `ZiboMotivationWidgetProvider.kt`
     `RemoteViews.addView(...)` ile ÇALIŞMA ZAMANINDA N tane
     `widget_quote_page.xml` örneği ekliyor, `android:flipInterval` +
     `autoStart="true"` sayesinde bunlar arasındaki geçiş TAMAMEN NATIVE
     (launcher sürecinin kendi UI thread'inde çalışan bir animasyon) —
     Dart/uygulama HİÇ AÇIK OLMASA BİLE, `updatePeriodMillis`'in Android'in
     dayattığı 30 dakikalık ALT SINIRINDAN TAMAMEN BAĞIMSIZ olarak, home
     ekranına eklendiği sürece kendi başına dönmeye devam ediyor (bkz. o
     dosyadaki dokümantasyon — `ViewFlipper` bir "arka plan uyandırma"
     mekanizması DEĞİL, sıradan bir View animasyonu, bu yüzden OS'in
     periyodik widget güncelleme kısıtlamalarına HİÇ tabi değil). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_character"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            android:src="@drawable/widget_zibo_character"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/widget_secondary_text"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Zibo'nun Sözü" />

            <!-- Diğer widget'lardaki accent bar'la AYNI desen — bkz.
                 `widget_module.xml`'deki dokümantasyon (ham `<View>`
                 spacer YERİNE, RemoteViews'ın desteklediği bir TextView). -->
            <TextView
                android:id="@+id/widget_accent_bar"
                android:layout_width="30dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp" />

            <ViewFlipper
                android:id="@+id/widget_quote_flipper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:flipInterval="180000"
                android:autoStart="true"
                android:inAnimation="@anim/widget_page_in"
                android:outAnimation="@anim/widget_page_out">
                <!-- Boş, "senkron henüz hiç çalışmadı" durumu için TEK bir
                     yer tutucu sayfa — Kotlin tarafı ZATEN gerçek veri
                     geldiğinde `removeAllViews` + gerçek sayfaları EKLİYOR,
                     bu yalnızca ilk anlık görüntü/önizleme (previewLayout)
                     için boş kalmasın diye. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_primary_text"
                    android:maxLines="4"
                    android:ellipsize="end"
                    tools:text="Zor günler geçer, sen kalıcısın." />
            </ViewFlipper>
        </LinearLayout>
    </LinearLayout>

    <!-- Zibo logosu — kompakt widget'larla AYNI marka imzası deseni VE AYNI
         akıcı "flip-book" shake `ViewFlipper`'ı (bkz. widget_module.xml'deki
         AYNI notun tam açıklaması — alpha 0.68, 28 kare, ince sinüs adımlı,
         flipInterval=70ms, YENİ PNG YOK). -->
    <ViewFlipper
        android:id="@+id/widget_logo_flipper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:flipInterval="70"
        android:autoStart="true">
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="4" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="7" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="8" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="7" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="4" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="-4" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="-7" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="-8" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="-7" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="-4" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
        <ImageView android:layout_width="48dp" android:layout_height="20dp" android:src="@drawable/widget_zibo_logo" android:alpha="0.68" android:scaleType="fitEnd" android:rotation="0" android:importantForAccessibility="no" />
    </ViewFlipper>
</FrameLayout>
