<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 13+ (API 33) için çalışma zamanı bildirim izni gerekiyor —
         bkz. NotificationProvider.initializeAndSchedule(). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Ayarlar'daki "pil optimizasyonunu kapat" isteği için — bkz.
         NotificationService.requestIgnoreBatteryOptimizations(). Google
         Play, bunun yalnızca gerçek bir kullanıcı işlemiyle (buton/anahtar)
         tetiklenmesini şart koşuyor; uygulama bunu otomatik/gizli
         çağırmıyor. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Profil fotoğrafı seçimi (bkz. PhotoPickerService/ImagePickerPhotoService)
         Android'in sistem "Photo Picker"ını kullanıyor (image_picker'ın
         ImageSource.gallery çağrısı, API 33+'ta OTOMATİK olarak bunu
         seçiyor) — bu, HİÇBİR çalışma zamanı izni GEREKTİRMEZ, tam galeri
         erişimi yerine kullanıcının yalnızca seçtiği fotoğrafı paylaşan
         güvenli bir sistem arayüzü. `READ_EXTERNAL_STORAGE` yalnızca Photo
         Picker'ın YERLEŞİK OLARAK bulunmadığı Android 12L ve altı (API 32-)
         cihazlarda eski/geri düşüş yolu için bildirilmiştir
         (`maxSdkVersion="32"` ile API 33+'ta bu iznin hiçbir etkisi yok,
         asla istenmiyor) — bkz. Android'in resmi Photo Picker geçiş
         rehberi. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- Manifest süsleme editörünün "Galeriye Kaydet"i (`gal` paketi) —
         yalnızca Android 10 (API 29) ve altında gerekli; yeni sürümlerde
         MediaStore izinsiz yazıyor, bu izin hiç istenmiyor. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <!-- 2026 — Appodeal reklam mediasyonu. Bazı reklam ağı adaptörleri
         (özellikle ileride eklenebilecek Meta / Mintegral / InMobi) manifest
         merge sırasında konum izinlerini sessizce enjekte edebiliyor. Zibo
         konumu HİÇBİR özellik için kullanmıyor ve Google Play, konum iznini
         "yalnızca reklam/analitik amacıyla" istemeyi AÇIKÇA yasaklıyor (bkz.
         Appodeal "What's next" dokümanı). Bu yüzden merge'de gelseler bile
         `tools:node="remove"` ile zorla çıkarılıyorlar — mevcut adaptör
         setinde (AppLovin/Vungle, bkz. build.gradle.kts) gelmiyorlar ama bu
         bir güvenlik ağı. -->
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="remove"/>
    <application
        android:label="Zibo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Ana ekran widget'larına (bkz. CLAUDE.md "Ana Ekran
                 Widget'ları" bölümü) dokununca `HomeWidgetLaunchIntent`in
                 ürettiği PendingIntent'in AYNI MainActivity örneğine doğru
                 yönlendirilmesi için — `home_widget` paketinin kendi resmi
                 örneğindeki AYNI desen. -->
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.LAUNCH"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Ana ekran widget'ları (bkz. CLAUDE.md "Ana Ekran Widget'ları"
             bölümü). 2026 güncellemesi — kullanıcı isteğiyle beş "basit
             günlük/checkbox" widget'ı (Hedef Takibi/Rüya Günlüğü/Şükran
             Günlüğü/Ruh Hali Takibi/Manifest Günlüğü) TAMAMEN KALDIRILDI,
             yerlerine PROFİL İSTATİSTİKLERİ carousel widget'ı geldi (bkz.
             altta `ZiboProfileStatsWidgetProvider`) — bu beşi zaten Profil
             ekranındaki dört kategoriyle ÖRTÜŞÜYORDU. Su Takibi/Para ve
             Birikim/Günlük Giriş Ödülleri (gerçekten farklı/eyleme
             geçirilebilir bilgi taşıyorlar) VE Zibo'nun Sözü KORUNDU. Kalan
             üç "basit" widget `res/layout/widget_module.xml`i paylaşan TEK
             bir ortak render mantığından (ZiboBaseWidgetProvider.kt) türüyor. -->
        <receiver
            android:name=".widgets.ZiboWaterWidgetProvider"
            android:label="Zibo — Su Takibi"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_water"/>
        </receiver>
        <receiver
            android:name=".widgets.ZiboMoneyWidgetProvider"
            android:label="Zibo — Para ve Birikim"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_money"/>
        </receiver>
        <receiver
            android:name=".widgets.ZiboDailyRewardsWidgetProvider"
            android:label="Zibo — Günlük Giriş Ödülleri"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_daily_rewards"/>
        </receiver>
        <!-- Daha büyük, ViewFlipper tabanlı carousel widget'ı — "Zibo'nun
             Sözü" (bkz. ZiboMotivationWidgetProvider.kt). -->
        <receiver
            android:name=".widgets.ZiboMotivationWidgetProvider"
            android:label="Zibo — Söz"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_motivation"/>
        </receiver>
        <!-- 2026 güncellemesi — beş kaldırılan basit widget'ın YERİNE:
             Profil ekranındaki "İstatistiklerim" dört kategorisini
             ViewFlipper ile sırayla, animasyonla döndüren carousel widget'ı
             (bkz. ZiboProfileStatsWidgetProvider.kt). -->
        <receiver
            android:name=".widgets.ZiboProfileStatsWidgetProvider"
            android:label="Zibo — İstatistiklerim"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_profile_stats"/>
        </receiver>
        <!-- 2026 güncellemesi — AdMob → Appodeal geçişi (bkz. CLAUDE.md
             "AdMob Entegrasyonu" bölümü, "AdMob/AdSense hesabı devre dışı
             bırakıldı" notu): `com.google.android.gms.ads.APPLICATION_ID`
             meta-data'sı VE `AdActivity` tema override'ı KALDIRILDI —
             `google_mobile_ads` paketi projeden TAMAMEN çıkarıldı, Appodeal
             App Key'i (bkz. lib/config/appodeal_config.dart) native manifest
             yerine DOĞRUDAN Dart'tan `Appodeal.initialize(appKey: ...)`'e
             geçiriliyor, ayrı bir manifest girdisi GEREKTİRMİYOR. -->
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Ayarlar > Destek/Hakkında bölümündeki "Bize Ulaşın" (mailto:)
             ve "Web Sitesi" (https:) linklerini url_launcher ile açabilmek
             için — Android 11+ paket görünürlüğü kısıtlaması bunlar açıkça
             listelenmeden canLaunchUrl()'ün hep false dönmesine yol açardı. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- 2026 — Ayarlar > Destek'teki "Bizi Puanlayın" yıldız sheet'i
             ÖNCE `market://` (Play Store uygulamasını DOĞRUDAN, tarayıcıya
             hiç uğramadan açar) deniyor, başarısız olursa `https:` (yukarıda
             zaten sorgulanabilir durumda) geri düşüşüne geçiyor — AYNI
             Android 11+ paket görünürlüğü gerekçesi. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="market"/>
        </intent>
        <!-- Bilinen agresif üreticilerin "otomatik başlatma" ayar
             ekranlarını sorgulayabilmek için (bkz.
             NotificationService.openAutostartOrAppSettings()) — Android 11+
             paket görünürlüğü kısıtlaması bunlar açıkça listelenmeden
             canResolveActivity()'nin hep false dönmesine yol açardı. -->
        <package android:name="com.miui.securitycenter"/>
        <package android:name="com.huawei.systemmanager"/>
        <package android:name="com.coloros.safecenter"/>
        <package android:name="com.vivo.permissionmanager"/>
        <package android:name="com.iqoo.secure"/>
        <package android:name="com.oneplus.security"/>
    </queries>
</manifest>
