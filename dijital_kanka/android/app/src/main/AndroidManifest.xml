<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ (API 33) için çalışma zamanı bildirim izni gerekiyor —
         bkz. NotificationProvider.initializeAndSchedule(). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Ayarlar'daki "pil optimizasyonunu kapat" isteği için — bkz.
         NotificationService.requestIgnoreBatteryOptimizations(). Google
         Play, bunun yalnızca gerçek bir kullanıcı işlemiyle (buton/anahtar)
         tetiklenmesini şart koşuyor; uygulama bunu otomatik/gizli
         çağırmıyor. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Profil fotoğrafı seçimi (bkz. PhotoPickerService/ImagePickerPhotoService)
         Android'in sistem "Photo Picker"ını kullanıyor (image_picker'ın
         ImageSource.gallery çağrısı, API 33+'ta OTOMATİK olarak bunu
         seçiyor) — bu, HİÇBİR çalışma zamanı izni GEREKTİRMEZ, tam galeri
         erişimi yerine kullanıcının yalnızca seçtiği fotoğrafı paylaşan
         güvenli bir sistem arayüzü. `READ_EXTERNAL_STORAGE` yalnızca Photo
         Picker'ın YERLEŞİK OLARAK bulunmadığı Android 12L ve altı (API 32-)
         cihazlarda eski/geri düşüş yolu için bildirilmiştir
         (`maxSdkVersion="32"` ile API 33+'ta bu iznin hiçbir etkisi yok,
         asla istenmiyor) — bkz. Android'in resmi Photo Picker geçiş
         rehberi. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <application
        android:label="Zibo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- AdMob SDK'sının UYGULAMA BAŞLATILMADAN önce okuduğu zorunlu alan
             (google_mobile_ads eklentisi bu meta-data yoksa çöker).
             Yeni Bireysel AdMob hesabının ("Zibo-Dijital Kankan" — eski
             Kuruluş türündeki hesap VAT ID sorunu yüzünden terk edildi)
             GERÇEK App ID'si (bkz. lib/config/admob_config.dart + CLAUDE.md
             "AdMob Entegrasyonu" bölümü). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-2881957853109429~2442148274"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Ayarlar > Destek/Hakkında bölümündeki "Bize Ulaşın" (mailto:)
             ve "Web Sitesi" (https:) linklerini url_launcher ile açabilmek
             için — Android 11+ paket görünürlüğü kısıtlaması bunlar açıkça
             listelenmeden canLaunchUrl()'ün hep false dönmesine yol açardı. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- Bilinen agresif üreticilerin "otomatik başlatma" ayar
             ekranlarını sorgulayabilmek için (bkz.
             NotificationService.openAutostartOrAppSettings()) — Android 11+
             paket görünürlüğü kısıtlaması bunlar açıkça listelenmeden
             canResolveActivity()'nin hep false dönmesine yol açardı. -->
        <package android:name="com.miui.securitycenter"/>
        <package android:name="com.huawei.systemmanager"/>
        <package android:name="com.coloros.safecenter"/>
        <package android:name="com.vivo.permissionmanager"/>
        <package android:name="com.iqoo.secure"/>
        <package android:name="com.oneplus.security"/>
    </queries>
</manifest>
