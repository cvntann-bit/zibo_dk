rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Kök doküman (users/{uid}) — bir alt-koleksiyon DEĞİL. PushNotification
      // Service.touchLastActive()/initialize() buraya doğrudan `fcmToken`/
      // `lastActiveAt` yazıyor (bkz. push_notification_service.dart). Coin
      // verisiyle ilgisi yok, dokunulmadı.
      allow read, write: if isOwner();

      // --- coinState: coin ekonomisinin EN KRİTİK dokümanı ------------------
      // Mod APK/hile koruması İÇİN eklendi (bkz. CLAUDE.md "Coin Ekonomisi
      // Güvenliği" bölümü — orada bu kuralın NE YAPIP NE YAPAMADIĞI, ve
      // gerçek/tam koruma için neden Cloud Functions (Blaze plan) gerektiği
      // UZUN UZUN açıklanıyor). ÖZET: bu, istemcinin Firestore'a YAZABİLECEĞİ
      // coinState belgesinin ŞEKLİNİ ve TEK BİR YAZIMDA değişebilecek miktarı
      // kısıtlıyor — "sunucu tarafı yetki" DEĞİL, yalnızca bir hız
      // engelleyici (speed bump). Sunucu tarafı mutasyon mantığı (Cloud
      // Functions) OLMADAN, kararlı bir betikle tekrarlanan KÜÇÜK, kural
      // dostu yazımlarla bakiye yine de zamanla şişirilebilir.
      match /state/coinState {
        function isValidShape(d) {
          return d.balance is int && d.balance >= 0
            && d.totalEarned is int && d.totalEarned >= 0
            && d.totalSpent is int && d.totalSpent >= 0;
        }

        allow read: if isOwner();

        // İLK senkronizasyon (yerel veriden Firestore'a TEK SEFERLİK göç,
        // bkz. CloudStateStore.load()) — bu andan ÖNCEki gerçek işlem
        // geçmişi rules'a hiç görünmüyor, bu yüzden delta kısıtlaması
        // UYGULANAMAZ. Yalnızca şekil + gevşek bir üst sınır ("akıl
        // sağlığı" kontrolü — bugünkü test ölçeğinin ÇOK üzerinde, gerçekçi
        // hiçbir test bakiyesini reddetmez, yalnızca "999999999" tarzı
        // bariz bir fabrikasyonu engeller).
        allow create: if isOwner() && isValidShape(request.resource.data)
          && request.resource.data.balance <= 200000
          && request.resource.data.totalEarned <= 200000
          && request.resource.data.totalSpent <= 200000;

        // Sonraki HER yazım — asıl koruma burada:
        //   (1) totalEarned/totalSpent ASLA azalamaz (yalnızca artabilir) —
        //       CoinProvider._earn()/_spend()'in her ikisi de bu iki alanı
        //       yalnızca ARTIRIYOR, hiçbir kod yolu AZALTMIYOR.
        //   (2) bakiye değişimi HER ZAMAN (totalEarned artışı) - (totalSpent
        //       artışı)'na TAM EŞİT olmalı — _earn()/_spend()'in gerçek
        //       davranışının matematiksel bir yansıması (ikisi de balance'ı
        //       VE ilgili total'i AYNI miktarda, TEK bir çağrıda değiştirir).
        //   (3) TEK bir yazımda kazanılan/harcanan miktar, uygulamadaki EN
        //       BÜYÜK gerçek tek-işlem tutarını AŞAMAZ — her `earn*`/`spend*`
        //       çağrısı KENDİ `_save()`'ini ANINDA tetikliyor (bkz.
        //       CoinProvider._record), yani tek bir Firestore yazımı HER
        //       ZAMAN TEK bir mekaniğe karşılık gelir, asla birden fazlası
        //       birikmiş olarak gelmez.
        //       - Kazanma üst sınırı 10500 = en büyük coin paketi
        //         (coin_packages.dart, `coins_10000`): 10000 temel + 500
        //         bonus (`CoinPackage.totalCoins`). **Bir pakete bonus
        //         eklenince/paket büyüyünce bu sayı da büyümeli.**
        //       - Harcama üst sınırı 33000 = en pahalı kostüm
        //         (costumes.dart, Elmas Kaplama).
        //       **BU İKİ SAYI, ileride daha pahalı bir paket/kostüm/tema
        //       eklenirse ELLE YÜKSELTİLMELİ** — aksi halde o TEK satın alma
        //       Firestore'a YAZILAMAZ (CloudStateStore.save()'in try/catch'i
        //       hatayı sessizce yutar, yerel SharedPreferences'a yine de
        //       yazılır — yani oyun İÇİNDE hiçbir hata GÖRÜNMEZ, yalnızca o
        //       spesifik işlem sonrasında bulut senkronizasyonu sessizce
        //       durur; bu YAVAŞ/GÖRÜNMEZ bir bug sınıfı, dikkatli olun).
        allow update: if isOwner() && isValidShape(request.resource.data)
          && request.resource.data.totalEarned
             >= resource.data.get('totalEarned', 0)
          && request.resource.data.totalSpent
             >= resource.data.get('totalSpent', 0)
          && (request.resource.data.balance - resource.data.get('balance', 0))
             == (request.resource.data.totalEarned
                 - resource.data.get('totalEarned', 0))
              - (request.resource.data.totalSpent
                 - resource.data.get('totalSpent', 0))
          && (request.resource.data.totalEarned
              - resource.data.get('totalEarned', 0)) <= 10500
          && (request.resource.data.totalSpent
              - resource.data.get('totalSpent', 0)) <= 33000;

        allow delete: if false;
      }

      // Diğer TÜM durum belgeleri (hedefler, günlükler, kostüm/tema
      // SAHİPLİK listeleri, tercihler vb.) — coinState HARİÇ, eskisi gibi
      // tam yetkili kalıyor. Kostüm/tema `ownedIds` listeleri DE aynı sınıf
      // riski taşıyor (istemci doğrudan bir id ekleyip ödemeden "sahip"
      // olabilir) ama rules-only bir liste doğrulaması costumes.dart/
      // app_themes.dart ile SÜREKLİ senkron tutulması gereken, kırılgan bir
      // bakım yükü olurdu — bilerek kapsam DIŞI bırakıldı (bkz. CLAUDE.md).
      match /state/{stateDoc} {
        allow read, write: if isOwner() && stateDoc != 'coinState';
      }
    }

    // TrustedTimeProvider'ın FirestoreTrustedTimeService'i sunucu zaman
    // damgasını okumak için paylaşılan bir "ping" belgesine yazıp hemen
    // geri okuyor (bkz. trusted_time_service.dart) — belge içeriği
    // önemsiz, yalnızca kimliği doğrulanmış herhangi bir kullanıcının bu
    // yazma/okumayı yapabilmesi gerekiyor.
    match /_serverTime/{document} {
      allow read, write: if request.auth != null;
    }

    // Davet Et (referral) sistemi (bkz. CLAUDE.md "Davet Et" bölümü VE
    // lib/providers/referral_provider.dart) — İKİ kullanıcının coin
    // bakiyesini AYNI ANDA değiştirmek gerektiği için, davet edilenin
    // istemcisi davet edenin `coinState`'ine DOĞRUDAN yazAMIYOR (yukarıdaki
    // `isOwner()` kısıtlaması). Bunun yerine davet edilen SADECE bu
    // dar kapsamlı, CREATE-ONLY koleksiyona bir "işlem talebi" bırakıyor —
    // asıl coin kredisi `notification-scripts/src/processReferralRewards.js`
    // tarafından (Admin SDK ile, bu kuralları atlayarak, GÜVENİLİR taraf
    // olarak) bir SONRAKİ çalıştırmada işleniyor. İstemciler bu koleksiyonu
    // OKUYAMAZ/GÜNCELLEYEMEZ/SİLEMEZ — yalnızca KENDİ `refereeUid`'siyle,
    // kendi uid'inden FARKLI bir `referrerUid`'e, `status: 'pending'` olarak
    // yeni bir kayıt OLUŞTURABİLİR (self-referral rules seviyesinde de
    // engelleniyor — istemci tarafı kontrolün YANI SIRA, ikinci bir savunma
    // katmanı).
    match /referralRedemptions/{redemptionId} {
      allow create: if request.auth != null
        && request.resource.data.refereeUid == request.auth.uid
        && request.resource.data.referrerUid is string
        && request.resource.data.referrerUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow read, update, delete: if false;
    }

    // Kurucu Üye rozeti — Google hesabına bağlanan İLK 500 kullanıcıya
    // verilen, paylaşılan CANLI bir sayaç (bkz. CLAUDE.md "Kurucu Üye
    // Rozeti" bölümü VE lib/providers/founder_badge_provider.dart). TEK
    // doküman, istemci tarafında BİR Firestore transaction'ı ile
    // increment ediliyor — Firestore'un kendi optimistic-concurrency
    // transaction mekanizması aynı anda gelen iki isteğin ikisinin de
    // count'u 499'dan 500'e artırmasını (çakışan tarafı otomatik retry
    // ettirerek) engellediği için, Cloud Functions'a GEREK KALMADAN atomik
    // bir "ilk N kişi" garantisi mümkün oluyor. Bu kural o garantinin
    // İKİNCİ, sunucu-taraflı savunma katmanı: `count` yalnızca TAM +1
    // artabilir VE 500'e ulaştıktan SONRA HİÇBİR yazıma izin verilmez.
    //
    // `create` BİLEREK `false` — doküman istemciler tarafından ASLA
    // oluşturulamaz, yalnızca BİR KEZ `notification-scripts/src/
    // initFounderBadgeCounter.js` (Admin SDK, bu kuralları atlar) ile seed
    // ediliyor. Doküman henüz seed edilmediyse `resource` `null` olacağı
    // için `update` kuralı da doğal olarak reddeder (özellik sessizce
    // devre dışı kalır) — bu, `FounderBadgeProvider.claimIfEligible()`'ın
    // zaten kendi tarafında yaptığı `!statusSnap.exists` kontrolüyle
    // TUTARLI, çift katmanlı bir güvenlik.
    match /founderBadgeStatus/status {
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.count is int
        && resource.data.count < 500
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']);
      allow create, delete: if false;
    }
  }
}
